{
  "buildCommand": "EXPO_PUBLIC_API_URL=/api pnpm --filter mobile exec expo export --platform web",
  "outputDirectory": "apps/mobile/dist",
  "installCommand": "pnpm install --frozen-lockfile",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/admin/:path*",
      "destination": "/api/admin?path=:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}

{
  "buildCommand": "EXPO_PUBLIC_API_URL=/api pnpm --filter mobile exec expo export --platform web",
  "outputDirectory": "apps/mobile/dist",
  "installCommand": "pnpm install --frozen-lockfile",
  "framework": null,
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/demo?path=$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/((?!api/).*)",
      "dest": "/index.html"
    }
  ]
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Business {
  id                   String                @id @default(uuid())
  name                 String
  category             String
  address              String
  phone                String?
  email                String?
  registrationNumber   String
  registrationVerificationStatus String @default("demo_verified")
  registrationVerificationSource String @default("demo")
  registrationVerifiedAt DateTime?
  xrplAddress          String                @unique
  xrplSecret           String
  isActive             Boolean               @default(true)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  escrows              Escrow[]              @relation("BusinessEscrows")
  products             BusinessProduct[]
  paymentRequests      PaymentRequest[]
  chargeRequests       ChargeRequest[]       @relation("BusinessChargeRequests")
  refundReviewRequests RefundReviewRequest[] @relation("BusinessRefundReviewRequests")
}

model Consumer {
  id                   String                @id @default(uuid())
  name                 String
  phone                String?
  email                String?
  xrplAddress          String                @unique
  xrplSecret           String
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  escrows              Escrow[]              @relation("ConsumerEscrows")
  chargeRequests       ChargeRequest[]       @relation("ConsumerChargeRequests")
  refundReviewRequests RefundReviewRequest[] @relation("ConsumerRefundReviewRequests")
}

model BusinessProduct {
  id             String            @id @default(uuid())
  businessId     String
  name           String
  description    String?
  escrowType     String            @default("prepaid")
  totalAmount    Float
  monthlyAmount  Float
  months         Int?
  unitPrice      Float?
  validityMonths Int?
  isActive       Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  business       Business          @relation(fields: [businessId], references: [id])
  menuItems      ProductMenuItem[]
  escrows        Escrow[]
  paymentRequests PaymentRequest[]
  chargeRequests ChargeRequest[]

  @@index([businessId, isActive])
}

model PaymentRequest {
  id               String           @id @default(uuid())
  code             String           @unique
  businessId       String
  businessName     String
  businessCategory String?
  productId        String?
  productName      String?
  paymentModel     String?
  paymentAmount    Float?
  totalAmount      Float
  monthlyAmount    Float?
  months           Int?
  escrowType       String
  unitPrice        Float?
  validityMonths   Int?
  validFrom        String?
  validUntil       String?
  status           String           @default("pending")
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  business         Business         @relation(fields: [businessId], references: [id])
  product          BusinessProduct? @relation(fields: [productId], references: [id])

  @@index([businessId, status, createdAt])
  @@index([code, status])
}

model ProductMenuItem {
  id             String          @id @default(uuid())
  productId      String
  name           String
  amount         Float
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  product        BusinessProduct @relation(fields: [productId], references: [id])
  chargeRequests ChargeRequest[]

  @@index([productId, isActive])
}

model Escrow {
  id                   String                @id @default(uuid())
  consumerId           String
  businessId           String
  productId            String?
  consumerAddress      String
  businessAddress      String
  totalAmount          Float
  monthlyAmount        Float
  months               Int
  escrowType           String                @default("monthly")
  unitPrice            Float?
  validityMonths       Int?
  currency             String                @default("RLUSD")
  issuer               String
  status               String                @default("active")
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  consumer             Consumer              @relation("ConsumerEscrows", fields: [consumerId], references: [id])
  business             Business              @relation("BusinessEscrows", fields: [businessId], references: [id])
  product              BusinessProduct?      @relation(fields: [productId], references: [id])
  entries              EscrowEntry[]
  chargeRequests       ChargeRequest[]
  refundReviewRequests RefundReviewRequest[]

  @@index([businessId, status, createdAt])
  @@index([consumerId, status, createdAt])
  @@index([status, createdAt])
}

model RefundReviewRequest {
  id                       String    @id @default(uuid())
  escrowId                 String
  consumerId               String
  businessId               String
  status                   String    @default("merchant_review")
  refundableAmount         Float
  merchantRespondBy        DateTime
  businessClosureStatus    String    @default("not_checked")
  businessClosureSource    String?
  businessClosureCheckedAt DateTime?
  investigationReason      String?
  consumerReason           String?
  merchantNotice           String?
  merchantResponse         String?
  merchantRespondedAt      DateTime?
  adminResolutionReason    String?
  photoDataUrlsJson        String?
  requestedAt              DateTime  @default(now())
  resolvedAt               DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  escrow                   Escrow    @relation(fields: [escrowId], references: [id])
  consumer                 Consumer  @relation("ConsumerRefundReviewRequests", fields: [consumerId], references: [id])
  business                 Business  @relation("BusinessRefundReviewRequests", fields: [businessId], references: [id])

  @@index([status, requestedAt])
  @@index([businessId, status, requestedAt])
  @@index([consumerId, status, requestedAt])
  @@index([escrowId, status])
}

model EscrowEntry {
  id          String   @id @default(uuid())
  escrowId    String
  month       Int
  sequence    Int
  amount      String
  finishAfter Int
  cancelAfter Int
  status      String   @default("pending")
  txHash      String?
  version     Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  escrow      Escrow   @relation(fields: [escrowId], references: [id])

  @@index([escrowId, status])
}

model ChargeRequest {
  id          String           @id @default(uuid())
  escrowId    String
  consumerId  String
  businessId  String
  productId   String?
  menuItemId  String?
  menuName    String
  amount      Float
  status      String           @default("pending_approval")
  entryIds    String
  requestedAt DateTime         @default(now())
  approvedAt  DateTime?
  settledAt   DateTime?
  rejectedAt  DateTime?
  txHash      String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  version     Int              @default(0)
  escrow      Escrow           @relation(fields: [escrowId], references: [id])
  consumer    Consumer         @relation("ConsumerChargeRequests", fields: [consumerId], references: [id])
  business    Business         @relation("BusinessChargeRequests", fields: [businessId], references: [id])
  product     BusinessProduct? @relation(fields: [productId], references: [id])
  menuItem    ProductMenuItem? @relation(fields: [menuItemId], references: [id])

  @@index([escrowId, status])
  @@index([businessId, status, requestedAt])
  @@index([consumerId, status, requestedAt])
}
